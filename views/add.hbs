<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <main class="screen add-screen">
        <header class="app-header">
            <h1>{{title}}</h1>
        </header>

        <div class="add-scroll">
            {{#if nutrient}}
                {{!-- ЧЕРНОВИК ЕСТЬ: название показано (readonly),
                     показ фото/видео, заполнение категории, нормы, единицы,
                     описание — внизу. Кнопка «Опубликовать». --}}

                <div class="media-block">
                    <span class="media-label">📷 Изображение</span>
                    {{#if nutrient.imageKey}}
                        <img src="http://localhost:9000/media/{{nutrient.imageKey}}" alt="Изображение" class="preview-media">
                    {{else}}
                        <img src="/img/default-image.jpg" alt="Изображение по умолчанию" class="preview-media">
                    {{/if}}
                </div>

                <div class="media-block">
                    <span class="media-label">🎬 Видео</span>
                    {{#if nutrient.videoKey}}
                        <video src="http://localhost:9000/media/{{nutrient.videoKey}}" class="preview-media" controls></video>
                    {{else}}
                        <video src="/img/default-video.mp4" class="preview-media" controls></video>
                    {{/if}}
                </div>

                <form action="/nutrients/publish" method="POST" class="add-form">
                    <input type="hidden" name="id" value="{{nutrient.id}}">

                    <label>Название
                        <input type="text" value="{{nutrient.name}}" readonly>
                    </label>
                    <label>Категория
                        <input type="text" name="category" value="{{nutrient.category}}" required>
                    </label>
                    <label>Суточная норма
                        <input type="number" name="dailyNorm" value="{{nutrient.dailyNorm}}" step="any" required>
                    </label>
                    <label>Единица измерения
                        <input type="text" name="unit" value="{{nutrient.unit}}" required>
                    </label>
                    <label>Описание
                        <textarea name="description" required>{{nutrient.description}}</textarea>
                    </label>

                    <button type="submit" class="publish-btn">Опубликовать</button>
                </form>
            {{else}}
                {{!-- ЧЕРНОВИКА НЕТ: только название, фото, видео, кнопка «Далее» --}}

                <div class="media-block">
                    <span class="media-label">📷 Изображение</span>
                    <img src="/img/default-image.jpg" alt="По умолчанию" class="preview-media">
                    <input type="file" accept="image/*" class="file-upload-input" style="margin-top: 12px;">
                </div>

                <div class="media-block">
                    <span class="media-label">🎬 Видео</span>
                    <video src="/img/default-video.mp4" class="preview-media" controls></video>
                    <input type="file" accept="video/*" class="file-upload-input" style="margin-top: 12px;">
                </div>

                <form action="/nutrients/create" method="POST" class="add-form">
                    <label>Название
                        <input type="text" name="name" required>
                    </label>

                    <button type="submit" class="next-btn">Далее</button>
                </form>
            {{/if}}
        </div>

        {{> tabbar}}
    </main>
</body>
</html>