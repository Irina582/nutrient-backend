<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <main class="screen add-screen">
        <header class="app-header">
            <h1>{{title}}</h1>
        </header>

        <div class="add-scroll">
            {{#if nutrient}}

                <div class="media-block">
                    <span class="media-label">📷 Изображение</span>
                    <img src="{{defaultImage nutrient.imageUrl}}" alt="Текущее изображение" class="preview-media">
                    <input type="file" accept="image/*" class="file-upload-input" style="margin-top: 12px;">
                </div>

                <div class="media-block">
                    <span class="media-label">🎬 Видео</span>
                    <video src="{{defaultVideo nutrient.videoUrl}}" class="preview-media" controls></video>
                    <input type="file" accept="video/*" class="file-upload-input" style="margin-top: 12px;">
                </div>

                <form class="add-form">
                    <label>Название <input type="text" value="{{nutrient.name}}"></label>
                    <label>Категория <input type="text" value="{{nutrient.category}}"></label>

                    <label>Суточная норма <input type="number" value="{{nutrient.dailyNorm}}" step="any"></label>
                    <label>Единица измерения <input type="text" value="{{nutrient.unit}}"></label>

                    <label>Описание <textarea>{{nutrient.shortDescription}}</textarea></label>
                </form>
            {{else}}
                <p style="text-align:center;color:#999;padding:40px 0;">Черновик не найден</p>
            {{/if}}
        </div>

        {{> tabbar}}
    </main>
</body>
</html>