<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <main class="screen add-screen">
        <header class="app-header">
            <h1>{{title}}</h1>
        </header>

        <div class="add-scroll">
            {{#if nutrient}}
                
                <div class="media-block">
                    <span class="media-label">📷 Изображение</span>
                    <img src="http://localhost:9000/media/{{nutrient.imageKey}}" alt="Изображение нутриента" class="preview-media">
                </div>

                
                <div class="media-block">
                    <span class="media-label">🎬 Видео</span>
                    <video src="http://localhost:9000/media/{{nutrient.videoKey}}" class="preview-media" controls></video>
                </div>

                
                <form class="add-form">
                    <label>Название <input type="text" value="{{nutrient.name}}"></label>
                    <label>Категория <input type="text" value="{{nutrient.category}}"></label>
                    <div class="field-row">
                        <label>Суточная норма <input type="number" value="{{nutrient.dailyNorm}}" step="any"></label>
                        <label>Единица измерения <input type="text" value="{{nutrient.unit}}"></label>
                    </div>
                    <label>Описание <textarea>{{nutrient.description}}</textarea></label>
                </form>
            {{else}}
                <p style="text-align:center;color:#999;padding:40px 0;">Черновик не найден</p>
            {{/if}}
        </div>

        {{> tabbar}}
    </main>
</body>
</html>