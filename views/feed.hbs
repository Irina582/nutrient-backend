<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <main class="screen feed-screen">
        {{#if nutrient}}
            <div class="feed-media">
                {{#if nutrient.videoKey}}
                    <video src="http://localhost:9000/media/{{nutrient.videoKey}}" class="feed-video" autoplay loop muted playsinline></video>
                {{else}}
                    <video src="/img/default-video.mp4" class="feed-video" autoplay loop muted playsinline></video>
                {{/if}}

                <div class="feed-actions-right">
                    <span class="feed-likes">❤️ {{likesCount}}</span>
                    <a href="/nutrients/feed/{{nutrient.id}}?next=true" class="next-arrow" title="Следующий">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M6 9L12 15L18 9" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>
                    <p class="feed-norm">Норма: {{nutrient.dailyNorm}} {{nutrient.unit}}</p>
                </div>

                <div class="feed-overlay">
                    <p class="feed-title">{{nutrient.name}}</p>

                    <div class="desc-container">
                        <input type="checkbox" id="descToggle" class="desc-checkbox">
                        <p class="desc-text">{{nutrient.description}}</p>
                        <label for="descToggle" class="desc-label"></label>
                    </div>
                </div>
            </div>
        {{else}}
            <div class="feed-media" style="display:flex;align-items:center;justify-content:center;color:#fff;background:#1a1a1a;font-size:18px;">
                Нутриент не найден
            </div>
        {{/if}}

        {{> tabbar}}
    </main>
</body>
</html>