<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <main class="screen tile-screen">
        <header class="app-header">
            <form action="/nutrients" method="GET" class="filter-form">
                <div class="filter-slider-box">
                    <div class="filter-slider-header">
                        <span class="filter-slider-label">Норма:</span>
                        <span class="filter-slider-value">
                            {{minNorm}} - {{maxNorm}}
                        </span>
                    </div>

                    <div class="range-slider-wrapper">
                        <div class="range-slider-track"></div>
                        <input
                            type="range"
                            name="minNorm"
                            min="0"
                            max="150"
                            step="5"
                            value="{{minNorm}}"
                            class="filter-slider"
                            title="Минимальная норма"
                        >
                        <input
                            type="range"
                            name="maxNorm"
                            min="0"
                            max="150"
                            step="5"
                            value="{{maxNorm}}"
                            class="filter-slider"
                            title="Максимальная норма"
                        >
                    </div>

                    <div class="filter-slider-scale">
                        <span>0</span>
                        <span>30</span>
                        <span>60</span>
                        <span>90</span>
                        <span>120</span>
                        <span>150</span>
                    </div>
                </div>
                <button type="submit">НАЙТИ</button>
            </form>
        </header>

        <div class="tile-grid">
            {{#each nutrients}}
                <div class="card-block">
                    <a href="/nutrients/feed/{{this.id}}" class="card">
                        {{#if this.imageKey}}
                            <img src="http://localhost:9000/media/{{this.imageKey}}" alt="{{this.name}}" class="card-image" loading="lazy">
                        {{else}}
                            <img src="/img/default-image.jpg" alt="{{this.name}}" class="card-image" loading="lazy">
                        {{/if}}
                        <div class="card-info">
                            <p class="card-title">{{this.name}}</p>
                            <p class="card-likes">{{this.likesCount}}</p>
                        </div>
                    </a>
                    <form action="/nutrients/delete" method="POST" class="delete-form">
                        <input type="hidden" name="id" value="{{this.id}}">
                        <button type="submit" class="delete-btn">Удалить</button>
                    </form>
                </div>
            {{else}}
                <p style="grid-column: 1/-1; text-align: center; color: #999; padding: 40px 0;">Нутриенты не найдены</p>
            {{/each}}
        </div>

        {{> tabbar}}
    </main>
</body>
</html>