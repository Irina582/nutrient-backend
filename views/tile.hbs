<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <main class="screen tile-screen">
        <header class="app-header">
            <form action="/nutrients" method="GET" class="filter-form">
                <div class="filter-slider-box">
                    <div class="filter-slider-header">
                        <span class="filter-slider-label">Мин. норма:</span>
                        <span class="filter-slider-value">
                            {{#if minNorm}}{{minNorm}}{{else}}все{{/if}}
                        </span>
                    </div>

                    <input
                        type="range"
                        id="normSlider"
                        name="minNorm"
                        min="0"
                        max="150"
                        step="5"
                        value="{{#if minNorm}}{{minNorm}}{{else}}0{{/if}}"
                        class="filter-slider"
                        title="Минимальная норма"
                    >

                    <!-- Риски: 31 шт (0..150 с шагом 5). Каждая 4-я — длинная -->
                    <div class="filter-slider-ticks" aria-hidden="true">
                        <span></span><span></span><span></span><span></span><span></span>
                        <span></span><span></span><span></span><span></span><span></span>
                        <span></span><span></span><span></span><span></span><span></span>
                        <span></span><span></span><span></span><span></span><span></span>
                        <span></span><span></span><span></span><span></span><span></span>
                        <span></span><span></span><span></span><span></span><span></span>
                        <span></span>
                    </div>

                    <!-- Подписи: 0, 30, 60, 90, 120, 150 — 6 шт -->
                    <div class="filter-slider-scale">
                        <span>0</span>
                        <span>30</span>
                        <span>60</span>
                        <span>90</span>
                        <span>120</span>
                        <span>150</span>
                    </div>
                </div>
                <button type="submit">НАЙТИ</button>
            </form>
        </header>

        <div class="tile-grid">
            {{#each nutrients}}
            <a href="/nutrients/feed/{{this.id}}" class="card">
                <img src="http://localhost:9000/media/{{this.imageKey}}" alt="{{this.name}}" class="card-image" loading="lazy">
                <div class="card-info">
                    <p class="card-title">{{this.name}}</p>
                    <p class="card-likes">{{this.likesCount}}</p>
                </div>
            </a>
            {{else}}
            <p style="grid-column: 1/-1; text-align: center; color: #999; padding: 40px 0;">Нутриенты не найдены</p>
            {{/each}}
        </div>

        {{> tabbar}}
    </main>
</body>
</html>